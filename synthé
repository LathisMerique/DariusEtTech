#include "daisy_seed.h"
#include "daisysp.h"

using namespace daisy;
using namespace daisysp;

DaisySeed hardware;
Oscillator osc;
Svf filter; 

void MyCallback(AudioHandle::InterleavingInputBuffer in,
                AudioHandle::InterleavingOutputBuffer out,
                size_t size)
{
    for(size_t i = 0; i < size; i += 2)
    {
        
        float signal = osc.Process();
        
    
        filter.Process(signal);
        
     
        signal = filter.Low();

      
        out[i]     = signal;
        out[i + 1] = signal;
    }
}

int main(void)
{

    hardware.Configure();
    hardware.Init();
    double sr = hardware.AudioSampleRate();

  
    osc.Init(sr);
    osc.SetWaveform(Oscillator::WAVE_SAW); 
    osc.SetAmp(0.5f); // On baisse un peu le volume pour éviter de saturer avec le filtre

    filter.Init(sr);
    filter.SetRes(0.5f); 

    // Configuration des potards (ADC) 
    AdcChannelConfig adcConfig[2];
    // Potentiomètre 1 sur pin 15
    adcConfig[0].InitSingle(hardware.GetPin(15));
    // Potentiomètre 2 sur pin 16 
    adcConfig[1].InitSingle(hardware.GetPin(16));
    
    hardware.adc.Init(adcConfig, 2); 
    hardware.adc.Start();

    // Démarrage du son
    hardware.StartAudio(MyCallback);

    
    for(;;)
    {
        // Lecture des boutons (0.0 à 1.0)
        float val_bouton_1 = hardware.adc.GetFloat(0);
        float val_bouton_2 = hardware.adc.GetFloat(1);

        // Paramètre 1 : Fréquence de l'oscillateur
        // De 50Hz (grave) à 1000Hz (aigu)
        float freq_osc = 50.0f + (val_bouton_1 * 950.0f);
        osc.SetFreq(freq_osc);

        // Paramètre 2 : Fréquence du filtre 
        // Le filtre va s'ouvrir et se fermer
        float freq_flt = 100.0f + (val_bouton_2 * 5000.0f);
        filter.SetFreq(freq_flt);

      
        System::Delay(1);
    }
}
